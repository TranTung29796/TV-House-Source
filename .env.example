# Product website template environment
# Copy to .env.local for local development, or configure the same keys in Vercel/production.

NODE_ENV=development
PRODUCT_CODE=product-template
NEXT_PUBLIC_PRODUCT_NAME=Product Template
COMPANY_NAME=XSolt
NEXT_PUBLIC_APP_URL=http://localhost:3005
SUPPORT_EMAIL=
NEXT_PUBLIC_SUPPORT_EMAIL=
LEGAL_ENTITY=
GOVERNING_LAW=
REFUND_POLICY=
DATA_RETENTION_POLICY=

# Backend API: web only talks to backend. Keep one convention across local/Vercel.
BACKEND_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_BACKEND_API_BASE_URL=http://localhost:8080
BACKEND_INTERNAL_TOKEN=change-me-match-backend-internal-admin-token

# Supabase Auth / RLS. Required only when using Supabase auth/storage.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Billing: configure provider keys in Backend first. Web keeps only variant mapping for pricing CTA.
LEMON_SQUEEZY_API_KEY=
LEMON_SQUEEZY_WEBHOOK_SECRET=
LEMON_SQUEEZY_STORE_ID=
LEMON_SQUEEZY_VARIANT_ID=
LEMON_SQUEEZY_VARIANT_FREE=
LEMON_SQUEEZY_VARIANT_PRO=
LEMON_SQUEEZY_VARIANT_PRO_YEARLY=
LEMON_SQUEEZY_VARIANT_LIFETIME=
LEMON_SQUEEZY_VARIANT_TEAM=

# Optional analytics, email, logging.
POSTHOG_API_KEY=
POSTHOG_HOST=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
RESEND_API_KEY=
EMAIL_FROM=
ERROR_LOG_ENDPOINT=
ERROR_LOG_TOKEN=
ADMIN_EMAILS=

AUTH_SECRET=
OPENAI_API_KEY=
